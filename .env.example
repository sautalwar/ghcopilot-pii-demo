GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=sautalwar
GITHUB_REPO=ghcopilot-pii-demo
PORT=3000

# ─── Jira Integration ───
JIRA_MODE=mock                   # mock | cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=VULN

# ─── CVE Feed ───
NVD_API_KEY=                     # Optional — increases NVD rate limit (5/30s → 50/30s)
CVE_CACHE_TTL_SECONDS=300        # Default 5 min for NVD, 1 min for GitHub Advisory
CVE_DEFAULT_HOURS=72             # How far back to look for "latest" CVEs
